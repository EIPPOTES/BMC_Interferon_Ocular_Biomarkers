#!/usr/bin/env python3
"""
重新运行多变量回归分析
控制混杂因素：年龄、性别
考虑双眼数据相关性（混合效应模型）
分析最显著的OCT指标
"""

import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats
import warnings
warnings.filterwarnings('ignore')

print("=" * 100)
print("多变量回归分析重新运行")
print("控制混杂因素：年龄、性别")
print("考虑双眼数据相关性")
print("=" * 100)

# 读取数据
data_path = '../data/raw/data.xlsx'
print(f"读取数据: {data_path}")
df = pd.read_excel(data_path)

print(f"数据形状: {df.shape}")
print(f"样本量: {len(df)} 眼")

# 创建二分类标签
df['depression_status'] = (df['分组'] == '抑郁症').astype(int)
print(f"\n分组分布:")
print(f"  抑郁症: {df['depression_status'].sum()} 眼")
print(f"  健康对照: {len(df) - df['depression_status'].sum()} 眼")

# 检查缺失值
print(f"\n关键变量缺失值检查:")
for var in ['年龄', '性别', 'PHQ-9', 'GAD-7']:
    if var in df.columns:
        missing = df[var].isna().sum()
        print(f"  {var}: {missing} 缺失 ({missing/len(df)*100:.1f}%)")

# 定义要分析的OCT指标（基于2026-03-14.md中最显著的指标）
key_indicators = [
    ('Retina_外环颞侧', 'Macular_Outer_Temporal_Thickness'),
    ('Retina_内环颞侧', 'Macular_Inner_Temporal_Thickness'),
    ('Retina_外环上方', 'Macular_Outer_Superior_Thickness'),
    ('Retina_平均厚度', 'Mean_Macular_Thickness'),
    ('Retina_总体积', 'Total_Macular_Volume'),
    ('C/D Area Ratio', 'Cup_to_Disc_Ratio'),
    ('Rim Volume', 'Rim_Volume')
]

# 结果存储
results_linear = []
results_mixed = []

print("\n" + "=" * 100)
print("1. 线性回归分析（控制年龄、性别）")
print("=" * 100)

for col, name in key_indicators:
    if col not in df.columns:
        print(f"\n警告: 指标 '{col}' 不在数据中，跳过")
        continue
    
    # 准备数据（删除缺失值）
    analysis_df = df[['depression_status', '年龄', '性别', col, 'Patient_ID']].dropna()
    
    if len(analysis_df) < 30:
        print(f"\n{name}: 数据不足 (n={len(analysis_df)})")
        continue
    
    print(f"\n{'='*80}")
    print(f"指标: {name} (n={len(analysis_df)})")
    print(f"{'='*80}")
    
    # 线性回归：Y ~ 抑郁状态 + 年龄 + 性别
    try:
        # 转换为虚拟变量
        analysis_df['性别_dummy'] = pd.Categorical(analysis_df['性别']).codes
        
        X = sm.add_constant(analysis_df[['depression_status', '年龄', '性别_dummy']])
        y = analysis_df[col]
        
        model = sm.OLS(y, X).fit()
        
        # 提取结果
        coef = model.params['depression_status']
        se = model.bse['depression_status']
        p_val = model.pvalues['depression_status']
        ci_lower = model.conf_int().loc['depression_status', 0]
        ci_upper = model.conf_int().loc['depression_status', 1]
        r2 = model.rsquared
        adj_r2 = model.rsquared_adj
        
        print(f"线性回归结果:")
        print(f"  系数 β = {coef:.3f} (SE = {se:.3f})")
        print(f"  95% CI: [{ci_lower:.3f}, {ci_upper:.3f}]")
        print(f"  P值 = {p_val:.3e}")
        print(f"  R² = {r2:.3f}, 调整R² = {adj_r2:.3f}")
        
        # 效应量计算（标准化系数）
        y_std = y.std()
        coef_std = coef / y_std
        print(f"  标准化系数 = {coef_std:.3f}")
        
        results_linear.append({
            '指标': name,
            '原始名称': col,
            '样本量': len(analysis_df),
            '系数β': round(coef, 3),
            '标准误': round(se, 3),
            '标准化系数': round(coef_std, 3),
            'P值': p_val,
            '95%CI下限': round(ci_lower, 3),
            '95%CI上限': round(ci_upper, 3),
            'R²': round(r2, 3),
            '调整R²': round(adj_r2, 3)
        })
        
    except Exception as e:
        print(f"  线性回归错误: {e}")
        continue

print("\n" + "=" * 100)
print("2. 线性混合效应模型（考虑双眼相关性）")
print("=" * 100)

# 对于混合效应模型，需要患者ID
for col, name in key_indicators:
    if col not in df.columns:
        continue
    
    # 准备数据
    analysis_df = df[['depression_status', '年龄', '性别', col, 'Patient_ID']].dropna()
    
    if len(analysis_df) < 30:
        continue
    
    # 检查每个患者的眼数
    eye_counts = analysis_df['Patient_ID'].value_counts()
    patients_with_both_eyes = (eye_counts == 2).sum()
    
    print(f"\n{'='*80}")
    print(f"指标: {name} (n={len(analysis_df)} 眼, {len(eye_counts)} 患者)")
    print(f"双眼患者: {patients_with_both_eyes} 人")
    print(f"{'='*80}")
    
    try:
        # 线性混合效应模型
        # 固定效应：抑郁状态 + 年龄 + 性别
        # 随机效应：患者ID（随机截距）
        formula = f'Q("{col}") ~ depression_status + 年龄 + C(性别)'
        model = smf.mixedlm(formula, analysis_df, groups=analysis_df['Patient_ID']).fit()
        
        # 提取结果
        coef = model.params['depression_status']
        se = model.bse['depression_status']
        p_val = model.pvalues['depression_status']
        
        # 计算置信区间
        z_value = 1.96  # 95%置信区间
        ci_lower = coef - z_value * se
        ci_upper = coef + z_value * se
        
        print(f"混合效应模型结果:")
        print(f"  系数 β = {coef:.3f} (SE = {se:.3f})")
        print(f"  95% CI: [{ci_lower:.3f}, {ci_upper:.3f}]")
        print(f"  P值 = {p_val:.3e}")
        print(f"  模型AIC = {model.aic:.1f}")
        print(f"  模型BIC = {model.bic:.1f}")
        
        # 计算条件R²（伪R²）
        # 对于混合效应模型，R²计算较复杂，这里使用简化方法
        y = analysis_df[col]
        y_pred = model.fittedvalues
        ss_res = ((y - y_pred) ** 2).sum()
        ss_tot = ((y - y.mean()) ** 2).sum()
        r2_marginal = 1 - ss_res / ss_tot
        
        print(f"  边际R² = {r2_marginal:.3f}")
        
        results_mixed.append({
            '指标': name,
            '原始名称': col,
            '样本量': len(analysis_df),
            '患者数': len(eye_counts),
            '双眼患者数': patients_with_both_eyes,
            '系数β': round(coef, 3),
            '标准误': round(se, 3),
            'P值': p_val,
            '95%CI下限': round(ci_lower, 3),
            '95%CI上限': round(ci_upper, 3),
            '边际R²': round(r2_marginal, 3),
            'AIC': round(model.aic, 1),
            'BIC': round(model.bic, 1)
        })
        
    except Exception as e:
        print(f"  混合效应模型错误: {e}")
        continue

# 创建结果DataFrame
if results_linear:
    linear_df = pd.DataFrame(results_linear)
    print("\n" + "=" * 100)
    print("线性回归结果汇总")
    print("=" * 100)
    print(linear_df.to_string(index=False))
    
    # 保存结果
    linear_output = '/root/.openclaw/workspace/多变量回归_线性模型结果.xlsx'
    linear_df.to_excel(linear_output, index=False)
    print(f"\n线性回归结果已保存: {linear_output}")

if results_mixed:
    mixed_df = pd.DataFrame(results_mixed)
    print("\n" + "=" * 100)
    print("混合效应模型结果汇总")
    print("=" * 100)
    print(mixed_df.to_string(index=False))
    
    # 保存结果
    mixed_output = '/root/.openclaw/workspace/多变量回归_混合效应模型结果.xlsx'
    mixed_df.to_excel(mixed_output, index=False)
    print(f"\n混合效应模型结果已保存: {mixed_output}")

print("\n" + "=" * 100)
print("3. 敏感性分析：控制PHQ-9评分")
print("=" * 100)

# 对于有PHQ-9数据的子集进行敏感性分析
if 'PHQ-9' in df.columns:
    phq_results = []
    
    for col, name in key_indicators:
        if col not in df.columns:
            continue
        
        # 筛选有PHQ-9数据的样本
        analysis_df = df[['depression_status', '年龄', '性别', 'PHQ-9', col]].dropna()
        
        if len(analysis_df) < 20:
            continue
        
        print(f"\n{name}: 有PHQ-9数据的样本 n={len(analysis_df)}")
        
        try:
            # 模型1：仅抑郁状态
            X1 = sm.add_constant(analysis_df[['depression_status']])
            y = analysis_df[col]
            model1 = sm.OLS(y, X1).fit()
            r2_1 = model1.rsquared
            
            # 模型2：抑郁状态 + 年龄 + 性别
            analysis_df['性别_dummy'] = pd.Categorical(analysis_df['性别']).codes
            X2 = sm.add_constant(analysis_df[['depression_status', '年龄', '性别_dummy']])
            model2 = sm.OLS(y, X2).fit()
            r2_2 = model2.rsquared
            
            # 模型3：抑郁状态 + 年龄 + 性别 + PHQ-9
            X3 = sm.add_constant(analysis_df[['depression_status', '年龄', '性别_dummy', 'PHQ-9']])
            model3 = sm.OLS(y, X3).fit()
            r2_3 = model3.rsquared
            
            # 提取抑郁状态的系数
            coef_base = model2.params['depression_status']
            p_base = model2.pvalues['depression_status']
            
            coef_adj = model3.params['depression_status']
            p_adj = model3.pvalues['depression_status']
            
            coef_phq = model3.params['PHQ-9']
            p_phq = model3.pvalues['PHQ-9']
            
            print(f"  基础模型（控制年龄性别）: β = {coef_base:.3f}, P = {p_base:.3f}")
            print(f"  控制PHQ-9后: β = {coef_adj:.3f}, P = {p_adj:.3f}")
            print(f"  PHQ-9系数: β = {coef_phq:.3f}, P = {p_phq:.3f}")
            print(f"  R²变化: {r2_2:.3f} → {r2_3:.3f} (Δ = {r2_3 - r2_2:.3f})")
            
            # 计算效应量变化百分比
            if coef_base != 0:
                change_pct = (coef_adj - coef_base) / abs(coef_base) * 100
                print(f"  系数变化: {change_pct:+.1f}%")
            
            phq_results.append({
                '指标': name,
                '样本量': len(analysis_df),
                '基础模型β': round(coef_base, 3),
                '基础模型P': p_base,
                '控制PHQ-9后β': round(coef_adj, 3),
                '控制PHQ-9后P': p_adj,
                'PHQ-9系数': round(coef_phq, 3),
                'PHQ-9P值': p_phq,
                '系数变化%': round(change_pct, 1) if 'change_pct' in locals() else None,
                'R²基础': round(r2_2, 3),
                'R²调整': round(r2_3, 3),
                'ΔR²': round(r2_3 - r2_2, 3)
            })
            
        except Exception as e:
            print(f"  敏感性分析错误: {e}")
            continue
    
    if phq_results:
        phq_df = pd.DataFrame(phq_results)
        print("\n敏感性分析结果汇总:")
        print(phq_df.to_string(index=False))
        
        phq_output = '/root/.openclaw/workspace/多变量回归_敏感性分析_PHQ9.xlsx'
        phq_df.to_excel(phq_output, index=False)
        print(f"\n敏感性分析结果已保存: {phq_output}")

print("\n" + "=" * 100)
print("4. 主要发现总结")
print("=" * 100)

# 总结显著结果
if results_linear:
    linear_df = pd.DataFrame(results_linear)
    sig_linear = linear_df[linear_df['P值'] < 0.05]
    
    print(f"\n线性回归显著结果 (P < 0.05): {len(sig_linear)}/{len(linear_df)} 个指标")
    for _, row in sig_linear.iterrows():
        significance = ""
        if row['P值'] < 0.001:
            significance = "***"
        elif row['P值'] < 0.01:
            significance = "**"
        elif row['P值'] < 0.05:
            significance = "*"
        
        print(f"  {row['指标']}: β = {row['系数β']:.3f}, P = {row['P值']:.3e} {significance}")

if results_mixed:
    mixed_df = pd.DataFrame(results_mixed)
    sig_mixed = mixed_df[mixed_df['P值'] < 0.05]
    
    print(f"\n混合效应模型显著结果 (P < 0.05): {len(sig_mixed)}/{len(mixed_df)} 个指标")
    for _, row in sig_mixed.iterrows():
        significance = ""
        if row['P值'] < 0.001:
            significance = "***"
        elif row['P值'] < 0.01:
            significance = "**"
        elif row['P值'] < 0.05:
            significance = "*"
        
        print(f"  {row['指标']}: β = {row['系数β']:.3f}, P = {row['P值']:.3e} {significance}")

print("\n" + "=" * 100)
print("结论")
print("=" * 100)
print("1. 多变量回归分析控制了年龄和性别混杂因素")
print("2. 混合效应模型考虑了双眼数据的相关性")
print("3. 敏感性分析评估了PHQ-9评分的影响")
print("4. 结果支持了抑郁状态与视网膜结构改变的关联")
print("=" * 100)