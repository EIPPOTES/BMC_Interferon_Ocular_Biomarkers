#!/usr/bin/env python3
"""Local Whisper using faster-whisper"""
import sys
import argparse
from faster_whisper import WhisperModel

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("audio_file", help="Path to audio file")
    parser.add_argument("--model", default="base", help="Model size (tiny, base, small, medium, large)")
    parser.add_argument("--language", "-l", default=None, help="Language code")
    parser.add_argument("--timestamps", "-t", action="store_true", help="Show timestamps")
    parser.add_argument("--json", "-j", action="store_true", help="Output JSON")
    args = parser.parse_args()
    
    # Map model names
    model_map = {
        "tiny": "tiny",
        "base": "base", 
        "small": "small",
        "medium": "medium",
        "large": "large-v3",
        "turbo": "base"
    }
    model_name = model_map.get(args.model, "base")
    
    # Run transcription
    model = WhisperModel(model_name, device="cpu", compute_type="int8")
    segments, info = model.transcribe(
        args.audio_file,
        language=args.language,
        word_timestamps=args.timestamps
    )
    
    if args.json:
        import json
        result = {
            "text": " ".join([s.text for s in segments]),
            "language": info.language if hasattr(info, 'language') else "unknown"
        }
        print(json.dumps(result))
    else:
        for segment in segments:
            if args.timestamps:
                print(f"[{segment.start:.2f}s - {segment.end:.2f}s] {segment.text}")
            else:
                print(segment.text, end=" ")
        print()

if __name__ == "__main__":
    main()
